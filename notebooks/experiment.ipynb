   "cell_type": "code",
   "execution_count": 53,
   "id": "7130cff2",
   "metadata": {},
   "outputs": [],
   "source": [
    "cv = StratifiedKFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "random_search = RandomizedSearchCV(\n",
    "    estimator=best_model,\n",
    "    param_distributions=param_grid,\n",
    "    n_iter=5,\n",
    "    scoring=\"f1_macro\",\n",
    "    cv=cv,\n",
    "    refit=True,\n",
    "    verbose=2,\n",
    "    random_state=RANDOM_STATE,\n",
    "    return_train_score=True\n",
    ")"
   ]
