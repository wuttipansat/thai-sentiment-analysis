   "source": [
    "#hyperparameters tuning\n",
    "\n",
    "param_grid = {\n",
    "    \"tfidf__ngram_range\": [\n",
    "        (2, 5),\n",
    "        (3, 5),\n",
    "        (3, 6),\n",
    "        (2, 6)\n",
