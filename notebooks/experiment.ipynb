    "\n",
    "    \"tfidf__max_features\": [\n",
    "        50_000,\n",
    "        100_000,\n",
    "        150_000,\n",
    "        200_000\n",
    "    ],\n",
    "\n",
    "    \"classifier__alpha\": [\n",
    "        1e-6,\n",
